<!-- 榜单列表项模板 (Neo-Arcade Style) -->
<template name="board-item">
  <block tt:for="{{rows}}" tt:key="id">
    <view tt:if="{{item.gap}}" class="arcade-gap">
      <view class="gap-dots">
        <view class="px-dot"></view><view class="px-dot"></view><view class="px-dot"></view>
      </view>
    </view>
    <view class="arcade-row {{item.medal ? 'arcade-row-top' : ''}} {{item.medal === 1 ? 'arcade-row-gold' : ''}}">
      <view tt:if="{{item.medal}}" class="arcade-medal medal-{{item.medal}}">{{item.rank}}</view>
      <text tt:else class="arcade-rank">{{item.rank}}</text>
      
      <view class="arcade-avatar" style="background-color: {{item.color}}">
        <text class="avatar-char">{{item.initial}}</text>
      </view>
      
      <text class="arcade-name">{{item.name}}</text>
      <text tt:if="{{item.isLast}}" class="arcade-cheer">冲榜</text>
      <text class="arcade-score {{item.medal === 1 ? 'score-gold' : ''}}">{{item.likesText}}</text>
    </view>
  </block>
</template>

<view class="arcade-console {{running ? 'console-running' : ''}}">
  
  <!-- ================= 未上屏配置状态 (IDLE) ================= -->
  <block tt:if="{{!running}}">
    <!-- 品牌与商业价值 Header -->
    <view class="arcade-hero">
      <view class="hero-brand">
        <view class="hero-bolt">⚡</view>
        <text class="hero-title">喜鹊 · 街机点赞冲关</text>
        <text class="hero-tag">PRO</text>
      </view>
      <text class="hero-desc">全自动点赞连击挂件 · 提升直播间互动留存与算法推流</text>
    </view>

    <!-- 模块 1：关卡目标设置 -->
    <view class="arcade-card">
      <view class="card-head">
        <view class="head-icon">🎯</view>
        <text class="head-title">冲关模式设置</text>
      </view>

      <view class="chip-row">
        <view tt:for="{{goalOptions}}" tt:key="value" 
              class="arcade-chip {{goalMode === item.value ? 'chip-on' : ''}}" 
              data-value="{{item.value}}" 
              bindtap="selectGoal">
          <text class="chip-text">{{item.label}}</text>
          <text tt:if="{{item.tag}}" class="chip-badge">{{item.tag}}</text>
        </view>
      </view>

      <view class="custom-input-row">
        <input class="arcade-input" 
               type="number" 
               placeholder="自定义单关点赞目标 (如 50000)" 
               value="{{customGoal}}" 
               bindinput="inputCustomGoal" />
        <view class="btn-set-goal" bindtap="confirmCustomGoal">应用</view>
      </view>

      <view class="arcade-hint-box">
        <text class="hint-bolt">⚡</text>
        <text class="hint-text">{{goalMode === 'auto' ? '智能连环关：1千 → 1万 → 5万 → 10万 → 50万（每达成一阶自动升级，全场播报破关喜讯）' : '当前固定目标：' + goalMode + ' 点赞即可通关'}}</text>
      </view>
    </view>

    <!-- 模块 2：挂件实播呈现 (1:1 街机挂件) -->
    <view class="arcade-card">
      <view class="card-head">
        <view class="head-icon">📺</view>
        <text class="head-title">直播间挂件效果</text>
        <text class="head-pill">150×96 紧凑设计</text>
      </view>

      <view class="arcade-stage">
        <!-- 街机卡片真实模拟展示 (150x96 @ 1.4x 放大比例展示) -->
        <view class="mock-arcade-card">
          <!-- 上部：Stage & 计分板 -->
          <view class="mock-top">
            <view class="mock-stage-pill">STAGE 02</view>
            <view class="mock-score">5.2万</view>
          </view>

          <!-- 10 段式能量槽 -->
          <view class="mock-gauge">
            <view tt:for="{{segments}}" tt:key="*this" class="mock-block {{item < 6 ? 'block-lit' : ''}}"></view>
          </view>

          <!-- 关卡差额信息 -->
          <view class="mock-meta">
            <text class="mock-diff">距破关还差 4.8万 赞</text>
            <text class="mock-pct">52%</text>
          </view>

          <!-- 像素打孔虚线 -->
          <view class="mock-divider"></view>

          <!-- 下部：MVP 榜首擂台 -->
          <view class="mock-mvp">
            <text class="mock-crown">👑</text>
            <view class="mock-avatar" style="background: {{sampleMVP.color}}">{{sampleMVP.initial}}</view>
            <view class="mock-mvp-info">
              <text class="mock-name">{{sampleMVP.name}}</text>
              <text class="mock-likes">贡献 {{sampleMVP.likesText}} 赞</text>
            </view>
            <view class="mock-tag">抢擂 ></view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ================= 运行中监控状态 (RUNNING) ================= -->
  <block tt:else>
    <!-- 运行状态条 -->
    <view class="arcade-status-bar">
      <view class="status-left">
        <view class="arcade-led {{subscription === 'connected' ? 'led-green' : 'led-yellow'}}"></view>
        <text class="status-title">{{subscription === 'connected' ? '互动挂载中' : '网络重连中'}}</text>
        <text class="status-timer">{{elapsed}}</text>
      </view>
      <view class="status-right">
        <text class="status-badge {{cardHidden ? 'badge-off' : 'badge-on'}}">
          {{cardHidden ? '挂件已隐藏' : '挂件展示中'}}
        </text>
      </view>
    </view>

    <!-- 街机计分板看板 (Scoreboard Card) -->
    <view class="arcade-card scoreboard-card">
      <view class="scoreboard-head">
        <view class="score-label-group">
          <text class="score-bolt">⚡</text>
          <text class="score-label">本场累计集气点赞 (SCORE)</text>
        </view>
        <view class="btn-tune-goal" bindtap="toggleGoalEditor">
          <text>{{editingGoal ? '收起配置' : '修改关卡'}}</text>
        </view>
      </view>

      <view class="scoreboard-hero">
        <text class="hero-num">{{totalText}}</text>
        <text class="hero-unit">次点赞</text>
      </view>

      <view class="gauge-monitor">
        <view class="gauge-slot">
          <view tt:for="{{segments}}" tt:key="*this" class="slot-block {{item < litSegments ? 'slot-lit' : ''}}"></view>
        </view>
        <text class="gauge-pct">{{percent}}%</text>
      </view>

      <view class="stage-info-row">
        <text class="stage-desc">当前: 第 {{level}} 关 (还差 {{remainingText}} 晋级)</text>
        <text class="players-count">共 {{viewerCount}} 位玩家参与</text>
      </view>

      <!-- 实时关卡调节抽屉 -->
      <view tt:if="{{editingGoal}}" class="inline-tuner">
        <view class="tuner-title">实时切换本场关卡：</view>
        <view class="chip-row">
          <view tt:for="{{goalOptions}}" tt:key="value" 
                class="arcade-chip {{goalMode === item.value ? 'chip-on' : ''}}" 
                data-value="{{item.value}}" 
                bindtap="selectGoal">
            <text class="chip-text">{{item.label}}</text>
          </view>
        </view>
        <view class="custom-input-row">
          <input class="arcade-input" type="number" placeholder="输入新目标" value="{{customGoal}}" bindinput="inputCustomGoal" />
          <view class="btn-set-goal" bindtap="confirmCustomGoal">生效</view>
        </view>
      </view>
    </view>

    <!-- 实时贡献排行榜 (TOP 6 + 末位冲榜) -->
    <view class="arcade-card">
      <view class="card-head">
        <view class="head-icon">👑</view>
        <text class="head-title">本场点赞贡献榜</text>
        <text class="head-pill">实时 TOP 6 + 冲榜位</text>
      </view>

      <view class="board-container">
        <template tt:if="{{board.length}}" is="board-item" data="{{rows: board}}" />
        <view tt:else class="board-empty-state">
          <view class="empty-icon">👾</view>
          <text class="empty-text">等待首位玩家点赞登顶 MVP...</text>
        </view>
      </view>

      <view class="btn-reset-data" bindtap="resetSession">
        <text>重置本场数据</text>
      </view>
    </view>
  </block>

  <!-- ================= 底部操作控制台 ================= -->
  <view class="arcade-bottom-dock">
    <view tt:if="{{!running}}" class="arcade-btn btn-launch" bindtap="startGame">
      <text class="btn-glow-text">⚡ 一键挂载上屏</text>
    </view>
    <block tt:else>
      <view class="arcade-btn btn-toggle" bindtap="toggleCardVisible">
        <text>{{cardHidden ? '恢复挂件展示' : '暂时隐藏挂件'}}</text>
      </view>
      <view class="arcade-btn btn-close" bindtap="closeGame">
        <text>下架并结束</text>
      </view>
    </block>
  </view>

</view>
