<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view>
        <view class="eyebrow">LIVE INTERACTION</view>
        <text class="hero-title">把每一次互动，<br />变成高光时刻</text>
        <text class="hero-desc">轻松管理直播间互动，让喜欢你的人被看见。</text>
      </view>
      <view class="hero-orb"><text>✦</text></view>
    </view>
    <view class="hero-bottom">
      <view class="live-pill"><view class="live-dot"></view><text>正在直播</text></view>
      <text class="hero-time">已运行 {{elapsedTime}}</text>
    </view>
  </view>

  <view class="section-head">
    <view><text class="section-title">直播概览</text><text class="section-subtitle">直播事件实时更新</text></view>
    <text class="status {{connected ? 'status-online' : ''}}">{{connected ? '数据已连接' : '连接中'}}</text>
  </view>
  <view class="metrics">
    <view class="metric metric-primary"><text class="metric-label">实时点赞</text><text class="metric-value">{{likeCount}}</text><text class="metric-note">累计收到</text></view>
    <view class="metric"><text class="metric-label">互动次数</text><text class="metric-value">{{interactionCount}}</text><text class="metric-note">全量事件累计</text></view>
  </view>
</view>
