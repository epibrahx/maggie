<!-- Template for leaderboard rows in panel -->
<template name="board-item">
  <block tt:for="{{rows}}" tt:key="id">
    <view tt:if="{{item.gap}}" class="board-gap">
      <view class="gap-dots">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
    </view>
    <view class="board-row {{item.medal ? 'board-row-top' : ''}} {{item.medal === 1 ? 'board-row-gold' : ''}}">
      <view tt:if="{{item.medal}}" class="medal medal-{{item.medal}}">{{item.rank}}</view>
      <text tt:else class="rank-num">{{item.rank}}</text>
      
      <view class="avatar-block" style="background-color: {{item.color}}">
        <text class="avatar-text">{{item.initial}}</text>
      </view>
      
      <text class="name-text">{{item.name}}</text>
      <text tt:if="{{item.isLast}}" class="cheer-badge">加油</text>
      <text class="likes-text {{item.medal === 1 ? 'likes-gold' : ''}}">{{item.likesText}}</text>
    </view>
  </block>
</template>

<view class="container {{running ? 'container-running' : ''}}">
  
  <!-- ================= IDLE STATE ================= -->
  <block tt:if="{{!running}}">
    <!-- Brand Header -->
    <view class="brand-hero">
      <view class="brand-badge">
        <view class="px-icon px-heart"></view>
        <text class="brand-title">喜鹊 · 毛玻璃互动卡</text>
      </view>
      <text class="brand-subtitle">半透明毛玻璃微卡 · 点赞目标与实时贡献榜</text>
    </view>

    <!-- Section 1: Goal Config -->
    <view class="card-box glass-panel">
      <view class="card-header">
        <view class="px-icon px-target"></view>
        <text class="card-title">点赞目标设定</text>
      </view>

      <view class="chip-grid">
        <view tt:for="{{goalOptions}}" tt:key="value" 
              class="chip-item {{goalMode === item.value ? 'chip-active' : ''}}" 
              data-value="{{item.value}}" 
              bindtap="selectGoal">
          <text class="chip-label">{{item.label}}</text>
          <text tt:if="{{item.tag}}" class="chip-tag">{{item.tag}}</text>
        </view>
      </view>

      <view class="custom-row">
        <input class="custom-input" 
               type="number" 
               placeholder="自定义点赞目标 (如 50000)" 
               value="{{customGoal}}" 
               bindinput="inputCustomGoal" />
        <view class="btn-custom" bindtap="confirmCustomGoal">设定</view>
      </view>

      <view class="tip-box">
        <text class="tip-icon">💡</text>
        <text class="tip-text">{{goalMode === 'auto' ? '自动档位：1千 → 1万 → 10万 → 50万 → 100万（每阶递增）' : '当前固定目标：' + goalMode + ' 点赞'}}</text>
      </view>
    </view>

    <!-- Section 2: Live Card Preview (With Live Video Simulation Backdrop) -->
    <view class="card-box glass-panel">
      <view class="card-header">
        <view class="px-icon px-screen"></view>
        <text class="card-title">观众端毛玻璃卡片预览</text>
        <text class="card-tag">150×168 半透明</text>
      </view>

      <!-- Preview Stage with Live Stream Simulation Background -->
      <view class="preview-stage-live">
        <view class="stream-backdrop">
          <view class="stream-circle c1"></view>
          <view class="stream-circle c2"></view>
          <view class="stream-badge">直播画面模拟</view>
        </view>

        <!-- Frosted Glass Live Card Mockup -->
        <view class="frosted-live-card">
          <!-- Top Goal Area -->
          <view class="glass-goal-area">
            <view class="glass-head">
              <view class="glass-heart">♥</view>
              <text class="glass-title">点赞目标</text>
              <text class="glass-total">5.2万</text>
            </view>
            
            <view class="glass-bar">
              <view tt:for="{{segments}}" tt:key="*this" class="glass-seg {{item < 6 ? 'glass-seg-on' : ''}}"></view>
            </view>
            
            <view class="glass-meta">
              <text class="glass-tier-pill">已达2档</text>
              <text class="glass-percent">52%</text>
              <text class="glass-remaining">还差 4.8万 升级</text>
            </view>
          </view>

          <!-- Frosted Divider -->
          <view class="glass-divider"></view>

          <!-- Bottom Board Area -->
          <view class="glass-board-area">
            <view class="glass-board-head">
              <view class="glass-crown">👑</view>
              <text class="glass-board-title">贡献榜</text>
              <text class="glass-count">128人参与</text>
            </view>
            
            <view class="glass-rows">
              <view tt:for="{{sampleTop4}}" tt:key="id" class="glass-row glass-row-{{item.medal}}">
                <view class="glass-medal glass-medal-{{item.medal}}">{{item.rank}}</view>
                <view class="glass-avatar" style="background: {{item.color}}">{{item.initial}}</view>
                <text class="glass-name">{{item.name}}</text>
                <text class="glass-likes {{item.medal === 1 ? 'glass-likes-gold' : ''}}">{{item.likesText}}</text>
              </view>
            </view>

            <view class="glass-tip">轻触屏幕点赞 · 实时冲榜 ✨</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ================= RUNNING STATE ================= -->
  <block tt:else>
    <!-- Status Header Bar -->
    <view class="status-bar glass-panel">
      <view class="status-left">
        <view class="pulse-dot {{subscription === 'connected' ? 'dot-online' : 'dot-warn'}}"></view>
        <text class="status-state">{{subscription === 'connected' ? '互动进行中' : (subscription === 'failed' ? '连接异常' : '连接中')}}</text>
        <text class="status-timer">{{elapsed}}</text>
      </view>
      <view class="status-right">
        <text class="visibility-badge {{cardHidden ? 'badge-hidden' : 'badge-visible'}}">
          {{cardHidden ? '卡片已隐藏' : '卡片展示中'}}
        </text>
      </view>
    </view>

    <!-- Live Goal Stats Card -->
    <view class="card-box glass-panel stats-card">
      <view class="stats-top">
        <view class="stats-label-group">
          <view class="px-icon px-heart"></view>
          <text class="stats-label">本场累计点赞</text>
        </view>
        <view class="btn-edit-goal" bindtap="toggleGoalEditor">
          <text>{{editingGoal ? '收起' : '修改目标'}}</text>
        </view>
      </view>

      <view class="stats-hero">
        <text class="stats-hero-num">{{totalText}}</text>
        <text class="stats-hero-unit">次点赞</text>
      </view>

      <view class="stats-progress-box">
        <view class="progress-bar">
          <view tt:for="{{segments}}" tt:key="*this" class="seg-block {{item < litSegments ? 'seg-lit' : ''}}"></view>
        </view>
        <text class="progress-percent">{{percent}}%</text>
      </view>

      <view class="stats-footer-info">
        <text class="stats-target-desc">当前目标: {{targetText}} (还差 {{remainingText}})</text>
        <text tt:if="{{goalMode === 'auto'}}" class="stats-tier-badge">已达成 {{level}} 档</text>
      </view>

      <!-- In-flight Goal Editor Drawer -->
      <view tt:if="{{editingGoal}}" class="inline-editor">
        <view class="inline-editor-title">快速修改目标：</view>
        <view class="chip-grid">
          <view tt:for="{{goalOptions}}" tt:key="value" 
                class="chip-item {{goalMode === item.value ? 'chip-active' : ''}}" 
                data-value="{{item.value}}" 
                bindtap="selectGoal">
            <text class="chip-label">{{item.label}}</text>
          </view>
        </view>
        <view class="custom-row">
          <input class="custom-input" type="number" placeholder="输入自定义目标" value="{{customGoal}}" bindinput="inputCustomGoal" />
          <view class="btn-custom" bindtap="confirmCustomGoal">应用</view>
        </view>
      </view>
    </view>

    <!-- Live Leaderboard Card -->
    <view class="card-box glass-panel board-card">
      <view class="card-header">
        <view class="px-icon px-crown"></view>
        <text class="card-title">观众点赞贡献榜</text>
        <text class="card-tag">Top 6 + 冲榜末位</text>
      </view>

      <view class="board-body">
        <template tt:if="{{board.length}}" is="board-item" data="{{rows: board}}" />
        <view tt:else class="board-empty">
          <view class="empty-icon">✨</view>
          <text class="empty-text">等待观众点赞上榜中...</text>
        </view>
      </view>

      <view class="reset-action" bindtap="resetSession">
        <text class="reset-text">重置本场数据</text>
      </view>
    </view>
  </block>

  <!-- ================= BOTTOM ACTION BAR ================= -->
  <view class="bottom-bar">
    <view tt:if="{{!running}}" class="btn-pixel btn-primary" bindtap="startGame">
      <view class="px-icon px-sparkle"></view>
      <text class="btn-text">开启毛玻璃互动卡</text>
    </view>
    <block tt:else>
      <view class="btn-pixel btn-ghost" bindtap="toggleCardVisible">
        <text class="btn-text">{{cardHidden ? '展示卡片' : '隐藏卡片'}}</text>
      </view>
      <view class="btn-pixel btn-danger" bindtap="closeGame">
        <text class="btn-text">结束玩法</text>
      </view>
    </block>
  </view>

</view>
