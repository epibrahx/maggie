/* ================= PAGE CONTAINER & THEME ================= */
page {
  background: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #0f172a;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px 16px 100px;
}

/* ================= PIXEL ICONS (CSS Box Shadow) ================= */
.px-icon {
  position: relative;
  width: 14px;
  height: 12px;
  margin-right: 8px;
  flex-shrink: 0;
}
.px-icon::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 2px;
  height: 2px;
}
.px-heart::before {
  color: #ff2d55;
  box-shadow:
    2px 0, 4px 0, 8px 0, 10px 0,
    0 2px, 2px 2px, 4px 2px, 6px 2px, 8px 2px, 10px 2px, 12px 2px,
    0 4px, 2px 4px, 4px 4px, 6px 4px, 8px 4px, 10px 4px, 12px 4px,
    2px 6px, 4px 6px, 6px 6px, 8px 6px, 10px 6px,
    4px 8px, 6px 8px, 8px 8px, 6px 10px;
}
.px-crown::before {
  color: #f59e0b;
  box-shadow:
    0 0, 6px 0, 12px 0,
    0 2px, 2px 2px, 6px 2px, 10px 2px, 12px 2px,
    0 4px, 2px 4px, 4px 4px, 6px 4px, 8px 4px, 10px 4px, 12px 4px,
    0 6px, 2px 6px, 4px 6px, 6px 6px, 8px 6px, 10px 6px, 12px 6px;
}
.px-target::before {
  color: #ff2d55;
  box-shadow:
    4px 0, 6px 0, 8px 0,
    2px 2px, 10px 2px,
    0 4px, 6px 4px, 12px 4px,
    0 6px, 4px 6px, 6px 6px, 8px 6px, 12px 6px,
    0 8px, 6px 8px, 12px 8px,
    2px 10px, 10px 10px,
    4px 12px, 6px 12px, 8px 12px;
}
.px-screen::before {
  color: #6366f1;
  box-shadow:
    0 0, 2px 0, 4px 0, 6px 0, 8px 0, 10px 0, 12px 0,
    0 2px, 12px 2px, 0 4px, 12px 4px, 0 6px, 12px 6px,
    0 8px, 2px 8px, 4px 8px, 6px 8px, 8px 8px, 10px 8px, 12px 8px,
    4px 10px, 6px 10px, 8px 10px;
}
.px-sparkle::before {
  color: #ffffff;
  box-shadow:
    6px 0,
    4px 2px, 6px 2px, 8px 2px,
    0 4px, 2px 4px, 4px 4px, 6px 4px, 8px 4px, 10px 4px, 12px 4px,
    4px 6px, 6px 6px, 8px 6px,
    6px 8px;
}

/* ================= BRAND HERO ================= */
.brand-hero {
  margin-bottom: 16px;
  padding: 4px 2px;
}
.brand-badge {
  display: flex;
  align-items: center;
}
.brand-title {
  font-size: 18px;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.3px;
}
.brand-subtitle {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #475569;
}

/* ================= GLASS PANEL CONTAINER ================= */
.card-box {
  background: rgba(255, 255, 255, 0.88);
  border: 1.5px solid rgba(255, 255, 255, 0.95);
  border-radius: 12px;
  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -1px rgba(15, 23, 42, 0.04);
  padding: 16px;
  margin-bottom: 16px;
}
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 14px;
}
.card-title {
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
}
.card-tag {
  margin-left: auto;
  font-size: 10px;
  font-weight: 600;
  color: #6366f1;
  background: rgba(99, 102, 241, 0.08);
  padding: 3px 7px;
  border-radius: 4px;
}

/* ================= GOAL SELECTION CHIPS ================= */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.chip-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 8px 14px;
  background: rgba(248, 250, 252, 0.9);
  border: 1.5px solid #e2e8f0;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  transition: all 0.15s ease;
}
.chip-item:active {
  transform: translateY(1px);
}
.chip-active {
  background: #fff1f2;
  border-color: #ff2d55;
  color: #ff2d55;
  box-shadow: 0 2px 8px rgba(255, 45, 85, 0.15);
}
.chip-tag {
  margin-left: 6px;
  font-size: 9px;
  background: #ff2d55;
  color: #ffffff;
  padding: 1px 4px;
  border-radius: 3px;
  font-weight: 700;
}

/* Custom Goal Input */
.custom-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
}
.custom-input {
  flex: 1;
  height: 38px;
  padding: 0 12px;
  background: rgba(248, 250, 252, 0.9);
  border: 1.5px solid #e2e8f0;
  border-radius: 8px;
  font-size: 13px;
  color: #0f172a;
}
.btn-custom {
  height: 38px;
  line-height: 38px;
  padding: 0 16px;
  background: #0f172a;
  color: #ffffff;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
}
.btn-custom:active {
  background: #1e293b;
}

.tip-box {
  display: flex;
  align-items: flex-start;
  margin-top: 12px;
  padding: 8px 10px;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 6px;
}
.tip-icon {
  font-size: 12px;
  margin-right: 6px;
}
.tip-text {
  flex: 1;
  font-size: 11px;
  color: #64748b;
  line-height: 1.4;
}

/* ================= LIVE CARD PREVIEW WITH LIVE STREAM BACKDROP ================= */
.preview-stage-live {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24px 0;
  border-radius: 12px;
  overflow: hidden;
  background: #1e1b4b;
}

/* Simulated live stream backdrop */
.stream-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 80% 20%, #4338ca 0%, #1e1b4b 60%, #0f172a 100%);
}
.stream-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(30px);
  opacity: 0.6;
}
.stream-circle.c1 {
  width: 140px;
  height: 140px;
  background: #ec4899;
  top: -20px;
  left: 10px;
}
.stream-circle.c2 {
  width: 120px;
  height: 120px;
  background: #06b6d4;
  bottom: -20px;
  right: 20px;
}
.stream-badge {
  position: absolute;
  left: 10px;
  top: 10px;
  font-size: 9px;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(0, 0, 0, 0.3);
  padding: 2px 6px;
  border-radius: 4px;
}

/* 150x168 Scaled 1.4x (210px x 235.2px) Frosted Glass Card */
.frosted-live-card {
  position: relative;
  z-index: 2;
  width: 210px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.85);
  border: 1.5px solid rgba(255, 255, 255, 0.95);
  border-radius: 10px;
  box-shadow: 0 12px 32px 0 rgba(0, 0, 0, 0.25), 0 2px 6px rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.glass-head {
  display: flex;
  align-items: center;
}
.glass-heart {
  color: #ff2d55;
  font-size: 13px;
  margin-right: 5px;
}
.glass-title {
  font-size: 12px;
  font-weight: 800;
  color: #0f172a;
}
.glass-total {
  margin-left: auto;
  font-size: 15px;
  font-weight: 900;
  color: #ff2d55;
  font-family: monospace;
}

.glass-bar {
  display: flex;
  gap: 2px;
  margin-top: 6px;
  padding: 2px;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 3px;
}
.glass-seg {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 1px;
}
.glass-seg-on {
  background: #ff2d55;
  box-shadow: 0 0 4px rgba(255, 45, 85, 0.4);
}

.glass-meta {
  display: flex;
  align-items: center;
  margin-top: 5px;
  font-size: 9.5px;
}
.glass-tier-pill {
  color: #ff2d55;
  background: rgba(255, 45, 85, 0.1);
  padding: 1px 4px;
  border-radius: 3px;
  font-weight: 700;
}
.glass-percent {
  margin-left: 6px;
  color: #ff2d55;
  font-weight: 800;
}
.glass-remaining {
  margin-left: auto;
  color: #64748b;
  font-size: 9px;
}

.glass-divider {
  height: 1px;
  background: rgba(226, 232, 240, 0.8);
  margin: 8px 0;
}

.glass-board-head {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}
.glass-crown {
  font-size: 11px;
  margin-right: 4px;
}
.glass-board-title {
  font-size: 11px;
  font-weight: 800;
  color: #334155;
}
.glass-count {
  margin-left: auto;
  font-size: 9px;
  color: #94a3b8;
}

.glass-rows {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.glass-row {
  display: flex;
  align-items: center;
  height: 22px;
  padding: 0 6px;
  background: rgba(248, 250, 252, 0.8);
  border: 1px solid rgba(226, 232, 240, 0.7);
  border-radius: 4px;
  font-size: 10px;
}
.glass-row-1 {
  background: rgba(254, 243, 199, 0.9);
  border-color: rgba(245, 158, 11, 0.4);
}
.glass-medal {
  width: 14px;
  height: 14px;
  line-height: 14px;
  text-align: center;
  font-size: 9px;
  font-weight: 800;
  color: #ffffff;
  border-radius: 3px;
}
.glass-medal-1 { background: #f59e0b; }
.glass-medal-2 { background: #94a3b8; }
.glass-medal-3 { background: #ea580c; }
.glass-avatar {
  width: 14px;
  height: 14px;
  line-height: 14px;
  text-align: center;
  color: #ffffff;
  font-size: 9px;
  font-weight: 700;
  border-radius: 3px;
  margin: 0 6px;
}
.glass-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #0f172a;
  font-weight: 600;
}
.glass-likes {
  margin-left: 6px;
  font-weight: 800;
  font-family: monospace;
  color: #475569;
}
.glass-likes-gold {
  color: #b45309;
}

.glass-tip {
  margin-top: 7px;
  text-align: center;
  font-size: 9px;
  color: #94a3b8;
}

/* ================= RUNNING STATE ================= */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  margin-bottom: 14px;
}
.status-left {
  display: flex;
  align-items: center;
}
.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 8px;
}
.dot-online {
  background: #10b981;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
}
.dot-warn {
  background: #f59e0b;
  box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
}
.status-state {
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
}
.status-timer {
  margin-left: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #64748b;
  font-family: monospace;
}
.visibility-badge {
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 4px;
  font-weight: 600;
}
.badge-visible {
  background: #dcfce7;
  color: #15803d;
}
.badge-hidden {
  background: #f1f5f9;
  color: #64748b;
}

/* Stats Card */
.stats-card {
  padding: 18px 16px;
}
.stats-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.stats-label-group {
  display: flex;
  align-items: center;
}
.stats-label {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
}
.btn-edit-goal {
  font-size: 12px;
  color: #ff2d55;
  font-weight: 600;
  padding: 4px 8px;
  background: #fff1f2;
  border-radius: 4px;
}

.stats-hero {
  display: flex;
  align-items: baseline;
  margin-top: 10px;
}
.stats-hero-num {
  font-size: 40px;
  font-weight: 900;
  color: #ff2d55;
  font-family: monospace;
  line-height: 1;
}
.stats-hero-unit {
  margin-left: 8px;
  font-size: 13px;
  color: #64748b;
  font-weight: 600;
}

.stats-progress-box {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 14px;
}
.progress-bar {
  flex: 1;
  display: flex;
  gap: 3px;
  background: rgba(0, 0, 0, 0.04);
  padding: 3px;
  border-radius: 4px;
}
.seg-block {
  flex: 1;
  height: 10px;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 2px;
}
.seg-lit {
  background: #ff2d55;
  box-shadow: 0 0 6px rgba(255, 45, 85, 0.4);
}
.progress-percent {
  font-size: 18px;
  font-weight: 800;
  color: #ff2d55;
  font-family: monospace;
  width: 48px;
  text-align: right;
}

.stats-footer-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  font-size: 12px;
  color: #64748b;
}
.stats-tier-badge {
  background: #fef3c7;
  color: #b45309;
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 600;
  font-size: 11px;
}

.inline-editor {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px dashed #cbd5e1;
}
.inline-editor-title {
  font-size: 12px;
  font-weight: 700;
  color: #334155;
  margin-bottom: 8px;
}

/* Leaderboard rows in panel */
.board-card {
  padding: 16px;
}
.board-body {
  margin-top: 8px;
}
.board-row {
  display: flex;
  align-items: center;
  height: 38px;
  margin-bottom: 6px;
  padding: 0 10px;
  background: rgba(248, 250, 252, 0.9);
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 13px;
}
.board-row-top {
  height: 42px;
}
.board-row-gold {
  background: rgba(254, 243, 199, 0.9);
  border-color: rgba(245, 158, 11, 0.4);
}
.medal {
  width: 20px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  border-radius: 4px;
}
.medal-1 { background: #f59e0b; }
.medal-2 { background: #94a3b8; }
.medal-3 { background: #ea580c; }
.rank-num {
  width: 20px;
  text-align: center;
  color: #94a3b8;
  font-size: 12px;
  font-weight: 700;
  font-family: monospace;
}
.avatar-block {
  width: 24px;
  height: 24px;
  line-height: 24px;
  text-align: center;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  border-radius: 4px;
  margin: 0 10px;
}
.name-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #0f172a;
  font-weight: 600;
}
.likes-text {
  margin-left: 8px;
  font-weight: 800;
  font-family: monospace;
  color: #334155;
  font-size: 13px;
}
.likes-gold {
  color: #b45309;
}
.cheer-badge {
  margin-left: 6px;
  padding: 1px 6px;
  background: #fff1f2;
  border: 1px solid #ff2d55;
  color: #ff2d55;
  font-size: 10px;
  font-weight: 700;
  border-radius: 3px;
}

.board-gap {
  display: flex;
  justify-content: center;
  padding: 4px 0;
}
.gap-dots {
  display: flex;
  gap: 4px;
}
.dot {
  width: 3px;
  height: 3px;
  background: #cbd5e1;
  border-radius: 50%;
}

.board-empty {
  padding: 30px 0;
  text-align: center;
}
.empty-icon {
  font-size: 24px;
  margin-bottom: 6px;
}
.empty-text {
  font-size: 12px;
  color: #94a3b8;
}

.reset-action {
  margin-top: 14px;
  padding: 10px 0;
  text-align: center;
  background: rgba(248, 250, 252, 0.8);
  border: 1px dashed #cbd5e1;
  border-radius: 8px;
}
.reset-text {
  font-size: 12px;
  color: #64748b;
  font-weight: 600;
}
.reset-action:active {
  background: #f1f5f9;
}

/* ================= BOTTOM BAR & BUTTONS ================= */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12px;
  padding: 12px 16px env(safe-area-inset-bottom, 20px);
  background: rgba(255, 255, 255, 0.92);
  border-top: 1px solid rgba(226, 232, 240, 0.8);
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.04);
}

.btn-pixel {
  flex: 1;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 700;
  transition: all 0.15s ease;
}
.btn-pixel:active {
  transform: translateY(1px);
}

.btn-primary {
  background: linear-gradient(135deg, #ff2d55 0%, #ff5277 100%);
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(255, 45, 85, 0.3);
}

.btn-ghost {
  background: rgba(248, 250, 252, 0.9);
  color: #0f172a;
  border: 1.5px solid #cbd5e1;
}

.btn-danger {
  background: #0f172a;
  color: #ffffff;
}
