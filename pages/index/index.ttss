/* ================= NEO-ARCADE 主播控制台主题 ================= */
page {
  background-color: #0c0f18;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #f8fafc;
}

.arcade-console {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px 16px 108px;
}

/* ================= 头部品牌展示 ================= */
.arcade-hero {
  margin-bottom: 16px;
  padding: 4px 2px;
}
.hero-brand {
  display: flex;
  align-items: center;
}
.hero-bolt {
  font-size: 18px;
  color: #ff3366;
  margin-right: 6px;
}
.hero-title {
  font-size: 19px;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -0.3px;
}
.hero-tag {
  margin-left: 8px;
  font-size: 10px;
  font-weight: 900;
  color: #0c0f18;
  background: #00e5a3;
  padding: 1px 6px;
  border-radius: 3px;
}
.hero-desc {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  color: #8d99ae;
}

/* ================= 街机切角卡片面板 (Chassis Panels) ================= */
.arcade-card {
  background: #141829;
  border: 1.5px solid #232b45;
  border-radius: 8px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  padding: 16px;
  margin-bottom: 16px;
  position: relative;
}
.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 14px;
}
.head-icon {
  font-size: 14px;
  margin-right: 8px;
}
.head-title {
  font-size: 15px;
  font-weight: 800;
  color: #ffffff;
}
.head-pill {
  margin-left: auto;
  font-size: 10px;
  font-weight: 700;
  color: #00e5ff;
  background: rgba(0, 229, 255, 0.12);
  padding: 2px 8px;
  border-radius: 4px;
  border: 1px solid rgba(0, 229, 255, 0.25);
}

/* ================= 街机切角选项芯片 (Arcade Chips) ================= */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.arcade-chip {
  position: relative;
  display: flex;
  align-items: center;
  padding: 8px 14px;
  background: #1c223a;
  border: 1.5px solid #2d3758;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  color: #c5cee0;
  transition: all 0.15s ease;
}
.arcade-chip:active {
  transform: translateY(1px);
}
.chip-on {
  background: rgba(255, 51, 102, 0.15);
  border-color: #ff3366;
  color: #ff3366;
  box-shadow: 0 0 10px rgba(255, 51, 102, 0.25);
}
.chip-badge {
  margin-left: 6px;
  font-size: 9px;
  background: #ff3366;
  color: #ffffff;
  padding: 1px 4px;
  border-radius: 3px;
  font-weight: 800;
}

/* 自定义目标输入框 */
.custom-input-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
}
.arcade-input {
  flex: 1;
  height: 38px;
  padding: 0 12px;
  background: #0f121e;
  border: 1.5px solid #2d3758;
  border-radius: 6px;
  font-size: 13px;
  color: #ffffff;
}
.btn-set-goal {
  height: 38px;
  line-height: 38px;
  padding: 0 16px;
  background: #232b45;
  border: 1px solid #3b4868;
  color: #ffffff;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
}
.btn-set-goal:active {
  background: #2d3758;
}

.arcade-hint-box {
  display: flex;
  align-items: flex-start;
  margin-top: 12px;
  padding: 9px 12px;
  background: rgba(0, 229, 255, 0.05);
  border: 1px solid rgba(0, 229, 255, 0.15);
  border-radius: 6px;
}
.hint-bolt {
  color: #00e5ff;
  font-size: 12px;
  margin-right: 6px;
}
.hint-text {
  flex: 1;
  font-size: 11px;
  color: #8d99ae;
  line-height: 1.45;
}

/* ================= 街机挂件实播模拟展示 (Stage Preview) ================= */
.arcade-stage {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 22px 0;
  background: #0a0d16;
  border-radius: 8px;
  border: 1px dashed #232b45;
}

/* 150x96 挂件标准比例展示 (210px x 134.4px) */
.mock-arcade-card {
  width: 210px;
  padding: 10px 12px;
  background: #121526;
  border: 2px solid #262b42;
  border-radius: 6px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  box-sizing: border-box;
}

.mock-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mock-stage-pill {
  font-size: 11px;
  font-weight: 900;
  color: #00e5ff;
  font-family: monospace;
  background: #0f121d;
  padding: 2px 6px;
  border-left: 2px solid #00e5ff;
}
.mock-score {
  font-size: 16px;
  font-weight: 900;
  color: #ff3366;
  font-family: monospace;
}

.mock-gauge {
  display: flex;
  gap: 2px;
  margin-top: 6px;
  padding: 2px;
  background: #0d101c;
}
.mock-block {
  flex: 1;
  height: 7px;
  background: #1c2237;
}
.block-lit {
  background: #ff3366;
}

.mock-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  font-size: 10px;
}
.mock-diff {
  color: #8d99ae;
  font-weight: 600;
}
.mock-pct {
  color: #ffffff;
  font-weight: 800;
  font-family: monospace;
}

.mock-divider {
  height: 1px;
  background: #232b45;
  margin: 7px 0;
}

.mock-mvp {
  display: flex;
  align-items: center;
  padding: 4px 6px;
  background: #0f121d;
  border: 1px solid #ffb800;
  border-radius: 4px;
}
.mock-crown {
  font-size: 11px;
  margin-right: 4px;
}
.mock-avatar {
  width: 14px;
  height: 14px;
  line-height: 14px;
  text-align: center;
  color: #ffffff;
  font-size: 9px;
  font-weight: 700;
  border-radius: 2px;
  margin-right: 6px;
}
.mock-mvp-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.mock-name {
  font-size: 10px;
  font-weight: 700;
  color: #ffffff;
}
.mock-likes {
  font-size: 9px;
  color: #ffb800;
  font-weight: 600;
}
.mock-tag {
  font-size: 9px;
  font-weight: 900;
  color: #ffffff;
  background: #ff3366;
  padding: 2px 6px;
  border-radius: 2px;
}

/* ================= 运行中状态栏 (Running HUD) ================= */
.arcade-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: #141829;
  border: 1.5px solid #232b45;
  border-radius: 8px;
  margin-bottom: 14px;
}
.status-left {
  display: flex;
  align-items: center;
}
.arcade-led {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 8px;
}
.led-green {
  background: #00e5a3;
  box-shadow: 0 0 8px #00e5a3;
}
.led-yellow {
  background: #ffb800;
  box-shadow: 0 0 8px #ffb800;
}
.status-title {
  font-size: 13px;
  font-weight: 800;
  color: #ffffff;
}
.status-timer {
  margin-left: 8px;
  font-size: 13px;
  font-weight: 700;
  color: #8d99ae;
  font-family: monospace;
}
.status-badge {
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 4px;
}
.badge-on {
  background: rgba(0, 229, 163, 0.15);
  color: #00e5a3;
  border: 1px solid rgba(0, 229, 163, 0.3);
}
.badge-off {
  background: rgba(141, 153, 174, 0.15);
  color: #8d99ae;
  border: 1px solid rgba(141, 153, 174, 0.3);
}

/* ================= 街机计分板监控大卡 (Scoreboard) ================= */
.scoreboard-card {
  padding: 18px 16px;
}
.scoreboard-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.score-label-group {
  display: flex;
  align-items: center;
}
.score-bolt {
  color: #ff3366;
  font-size: 14px;
  margin-right: 6px;
}
.score-label {
  font-size: 14px;
  font-weight: 800;
  color: #ffffff;
}
.btn-tune-goal {
  font-size: 12px;
  font-weight: 700;
  color: #ff3366;
  padding: 3px 8px;
  background: rgba(255, 51, 102, 0.12);
  border-radius: 4px;
}

.scoreboard-hero {
  display: flex;
  align-items: baseline;
  margin-top: 10px;
}
.hero-num {
  font-size: 42px;
  font-weight: 900;
  color: #ff3366;
  font-family: monospace;
  line-height: 1;
  text-shadow: 0 0 16px rgba(255, 51, 102, 0.3);
}
.hero-unit {
  margin-left: 8px;
  font-size: 13px;
  color: #8d99ae;
  font-weight: 700;
}

.gauge-monitor {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
}
.gauge-slot {
  flex: 1;
  display: flex;
  gap: 3px;
  background: #0d101c;
  padding: 3px;
  border-radius: 4px;
}
.slot-block {
  flex: 1;
  height: 10px;
  background: #1c2237;
  border-radius: 1px;
}
.slot-lit {
  background: #ff3366;
  box-shadow: 0 0 6px rgba(255, 51, 102, 0.5);
}
.gauge-pct {
  font-size: 18px;
  font-weight: 900;
  color: #ff3366;
  font-family: monospace;
  width: 48px;
  text-align: right;
}

.stage-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
  font-size: 12px;
  color: #8d99ae;
}
.players-count {
  font-weight: 700;
  color: #00e5ff;
}

.inline-tuner {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px dashed #232b45;
}
.tuner-title {
  font-size: 12px;
  font-weight: 800;
  color: #c5cee0;
  margin-bottom: 8px;
}

/* ================= 实时点赞贡献榜 (Leaderboard) ================= */
.board-container {
  margin-top: 8px;
}
.arcade-row {
  display: flex;
  align-items: center;
  height: 38px;
  margin-bottom: 6px;
  padding: 0 10px;
  background: #181d33;
  border: 1px solid #232b45;
  border-radius: 6px;
  font-size: 13px;
}
.arcade-row-top {
  height: 42px;
}
.arcade-row-gold {
  background: rgba(255, 184, 0, 0.08);
  border-color: #ffb800;
}
.arcade-medal {
  width: 20px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  color: #0c0f18;
  font-size: 11px;
  font-weight: 900;
  border-radius: 3px;
}
.medal-1 { background: #ffb800; }
.medal-2 { background: #c5cee0; }
.medal-3 { background: #ff9900; }
.arcade-rank {
  width: 20px;
  text-align: center;
  color: #8d99ae;
  font-size: 12px;
  font-weight: 800;
  font-family: monospace;
}
.arcade-avatar {
  width: 24px;
  height: 24px;
  line-height: 24px;
  text-align: center;
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  border-radius: 4px;
  margin: 0 10px;
}
.arcade-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #ffffff;
  font-weight: 700;
}
.arcade-score {
  margin-left: 8px;
  font-weight: 900;
  font-family: monospace;
  color: #c5cee0;
  font-size: 13px;
}
.score-gold {
  color: #ffb800;
}
.arcade-cheer {
  margin-left: 6px;
  padding: 1px 6px;
  background: rgba(255, 51, 102, 0.15);
  border: 1px solid #ff3366;
  color: #ff3366;
  font-size: 10px;
  font-weight: 800;
  border-radius: 3px;
}

.arcade-gap {
  display: flex;
  justify-content: center;
  padding: 4px 0;
}
.gap-dots {
  display: flex;
  gap: 4px;
}
.px-dot {
  width: 3px;
  height: 3px;
  background: #3b4868;
}

.board-empty-state {
  padding: 30px 0;
  text-align: center;
}
.empty-icon {
  font-size: 24px;
  margin-bottom: 6px;
}
.empty-text {
  font-size: 12px;
  color: #8d99ae;
}

.btn-reset-data {
  margin-top: 14px;
  padding: 10px 0;
  text-align: center;
  background: #181d33;
  border: 1px dashed #3b4868;
  border-radius: 6px;
  font-size: 12px;
  color: #8d99ae;
  font-weight: 700;
}
.btn-reset-data:active {
  background: #232b45;
}

/* ================= 底部操作控制台 (Bottom Dock) ================= */
.arcade-bottom-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12px;
  padding: 12px 16px env(safe-area-inset-bottom, 20px);
  background: #0c0f18;
  border-top: 1.5px solid #232b45;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.6);
}

.arcade-btn {
  flex: 1;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 800;
  transition: all 0.15s ease;
}
.arcade-btn:active {
  transform: translateY(1px);
}

.btn-launch {
  background: #ff3366;
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(255, 51, 102, 0.4);
}

.btn-toggle {
  background: #1c223a;
  color: #ffffff;
  border: 1.5px solid #3b4868;
}

.btn-close {
  background: #141829;
  color: #ff3366;
  border: 1.5px solid #ff3366;
}
